{
  "about": "Every case in the QAF form model conformance suite. Paths are relative to this file. See README.md for what each kind asks of a reader.",
  "model_version": 1,
  "bfl_version": 1,
  "suites": [
    { "kind": "schema", "file": "../../schema/form.schema.json" },
    { "kind": "expressions", "file": "expressions/cases.json" },
    { "kind": "expressions", "file": "expressions/php-edges.json" },
    { "kind": "valid-models", "files": [
      "models/valid/all-field-types.json",
      "models/valid/logic-and-layout.json",
      "models/valid/quiz-and-translations.json",
      "qaf/canonical/edge-cases.json",
      "qaf/canonical/priced-choices.json"
    ] },
    { "kind": "invalid-models", "file": "models/invalid/cases.json" },
    { "kind": "behaviour", "file": "models/behaviour.json" },
    { "kind": "qaf-canonical", "cases": [
      { "qaf": "qaf/canonical/all-field-types.qaf", "model": "models/valid/all-field-types.json" },
      { "qaf": "qaf/canonical/logic-and-layout.qaf", "model": "models/valid/logic-and-layout.json" },
      { "qaf": "qaf/canonical/quiz-and-translations.qaf", "model": "models/valid/quiz-and-translations.json" },
      { "qaf": "qaf/canonical/edge-cases.qaf", "model": "qaf/canonical/edge-cases.json" },
      { "qaf": "qaf/canonical/priced-choices.qaf", "model": "qaf/canonical/priced-choices.json" }
    ] },
    { "kind": "qaf-legacy", "cases": [
      { "qaf": "qaf/legacy/choices.qaf", "model": "qaf/legacy/choices.json", "canonical": "qaf/legacy/choices.canonical.qaf" },
      { "qaf": "qaf/legacy/compiler-output.qaf", "model": "qaf/legacy/compiler-output.json", "canonical": "qaf/legacy/compiler-output.canonical.qaf" },
      { "qaf": "qaf/legacy/conditions.qaf", "model": "qaf/legacy/conditions.json", "canonical": "qaf/legacy/conditions.canonical.qaf" },
      { "qaf": "qaf/legacy/modifiers-and-blocks.qaf", "model": "qaf/legacy/modifiers-and-blocks.json", "canonical": "qaf/legacy/modifiers-and-blocks.canonical.qaf" },
      { "qaf": "qaf/legacy/modifiers.qaf", "model": "qaf/legacy/modifiers.json", "canonical": "qaf/legacy/modifiers.canonical.qaf" },
      { "qaf": "qaf/legacy/library-keywords.qaf", "model": "qaf/legacy/library-keywords.json", "canonical": "qaf/legacy/library-keywords.canonical.qaf" },
      { "qaf": "qaf/legacy/pages-sections-columns.qaf", "model": "qaf/legacy/pages-sections-columns.json", "canonical": "qaf/legacy/pages-sections-columns.canonical.qaf" }
    ] },
    { "kind": "qaf-errors", "file": "qaf/errors.json" },
    { "kind": "builder", "qaf_only": true, "cases": [
      { "stored": "builder/saved-before-the-model.stored.json", "model": "builder/saved-before-the-model.model.json", "report": "builder/saved-before-the-model.report.json" },
      { "stored": "builder/logic-and-layout.stored.json", "model": "models/valid/logic-and-layout.json" }
    ] },
    { "kind": "imports", "qaf_only": true, "cases": [
      { "source": "gravity-forms", "input": "imports/gravity-forms/event-registration.json", "model": "imports/gravity-forms/event-registration.model.json", "report": "imports/gravity-forms/event-registration.report.json" },
      { "source": "wpforms", "input": "imports/wpforms/contact.json", "model": "imports/wpforms/contact.model.json", "report": "imports/wpforms/contact.report.json" },
      { "source": "contact-form-7", "input": "imports/contact-form-7/default-form.json", "model": "imports/contact-form-7/default-form.model.json", "report": "imports/contact-form-7/default-form.report.json" },
      { "source": "contact-form-7", "input": "imports/contact-form-7/plain-template.txt", "model": "imports/contact-form-7/plain-template.model.json", "report": "imports/contact-form-7/plain-template.report.json" },
      { "source": "ninja-forms", "input": "imports/ninja-forms/quote-request.json", "model": "imports/ninja-forms/quote-request.model.json", "report": "imports/ninja-forms/quote-request.report.json" },
      { "source": "google-forms", "input": "imports/google-forms/braille-quiz.json", "model": "imports/google-forms/braille-quiz.model.json", "report": "imports/google-forms/braille-quiz.report.json" }
    ] },
    { "kind": "exports", "qaf_only": true, "cases": [
      { "target": "gravity-forms", "model": "models/valid/logic-and-layout.json", "output": "exports/gravity-forms.logic-and-layout.json", "report": "exports/gravity-forms.logic-and-layout.report.json" },
      { "target": "wpforms", "model": "models/valid/logic-and-layout.json", "output": "exports/wpforms.logic-and-layout.json", "report": "exports/wpforms.logic-and-layout.report.json" },
      { "target": "contact-form-7", "model": "models/valid/logic-and-layout.json", "output": "exports/contact-form-7.logic-and-layout.txt", "report": "exports/contact-form-7.logic-and-layout.report.json" },
      { "target": "ninja-forms", "model": "models/valid/logic-and-layout.json", "output": "exports/ninja-forms.logic-and-layout.json", "report": "exports/ninja-forms.logic-and-layout.report.json" },
      { "target": "google-forms", "model": "models/valid/quiz-and-translations.json", "output": "exports/google-forms.quiz-and-translations.json", "report": "exports/google-forms.quiz-and-translations.report.json" }
    ] }
  ]
}
