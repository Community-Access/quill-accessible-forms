bfl 1
form "Modifiers"

text #code "Code"
  @pattern "[A-Z]{3}-[0-9]{4}"
  @autofocus
  @spellcheck false
fileupload #doc "Document"
  @accept "image/*,.pdf"
fileupload #photo "Photo"
  @capture "environment"
fileupload #selfie "Selfie"
  @capture "environment"
textarea #bio "Bio"
  @rows 10
  @cols 80
text #phone "Phone"
  @mask "(999) 999-9999"
  @inputmode "tel"
  @enterkeyhint "next"
email #email "Email"
  @unique
  @unique_scope "global"
  @unique_message "Already registered"
  @confirm_email
text #display_name "Name"
  @smart_default user("display_name")
date #start "Start"
  @smart_default today() + 7
date #today "Today"
  @smart_default today()
text #where "Country"
  @smart_default geo()
hidden #ref "Referrer"
  @smart_default query("ref")
text #plain "Plain"
  @smart_default "Hello"
address #ship "Shipping Address"
  @autocomplete
  @autocomplete_provider "google_places"
  @autocomplete_countries ["US","CA"]
  @autocomplete_types ["address"]
text #tagged "Tagged"
  @attr "data-analytics" "contact-form"
  @attr "aria-describedby" "hint1"
text #ro "Read only"
  @read_only
  @disabled
  @css_class "wide"
  @admin_only
  @visibility "hidden"
  @allow_other
number #qty "Quantity"
  @default 1
  @min 1
  @max 99
  @step 1
  @prefix "x"
  @suffix "items"
repeater #kids "Children"
  @min_rows 1
  @max_rows 4
